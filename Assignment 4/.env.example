# Server Port Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace with your MongoDB Atlas cluster URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/portfolio_db?retryWrites=true&w=majority

# Nodemailer SMTP Email Settings
# For Gmail, use an App Password (not your normal account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password

# Email recipient for portfolio contact notifications
RECEIVER_EMAIL=your_personal_email@domain.com
